{
  "sourceLanguage": "en",
  "strings": {
    "%lld running · %lld finished (24h)": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld rodando · %2$lld terminados (24h)"
          }
        }
      }
    },
    "%lld/%lld agents": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld agentes"
          }
        }
      }
    },
    "AgentBar %@ · Unofficial project, not affiliated with Anthropic.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "AgentBar %@ · Projeto não oficial, sem relação com a Anthropic."
          }
        }
      }
    },
    "AgentBar Settings": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes do AgentBar"
          }
        }
      }
    },
    "AgentBar reads your usage limits from Claude Code's status line. Connecting installs a small script and points the status line in settings.json to it. The status line you use today keeps working, and settings.json is backed up first.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AgentBar lê seus limites de uso pelo status line do Claude Code. Conectar instala um script pequeno e aponta o status line do settings.json para ele. O status line que você usa hoje continua funcionando, e o settings.json ganha um backup antes."
          }
        }
      }
    },
    "AgentBar will add a status line to %@. A backup of settings.json is saved in %@.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AgentBar vai adicionar um status line em %1$@. Um backup do settings.json fica em %2$@."
          }
        }
      }
    },
    "AgentBar will change the status line in %@. Your current status line (%@) keeps running through AgentBar's script. A backup of settings.json is saved in %@.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AgentBar vai trocar o status line em %1$@. O status line atual (%2$@) continua rodando pelo script do AgentBar. Um backup do settings.json fica em %3$@."
          }
        }
      }
    },
    "AgentBar will put back the status line you had before and remove its script. Your usage limits will stop updating.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AgentBar vai devolver o status line que você tinha antes e remover o script dele. Os limites de uso vão parar de atualizar."
          }
        }
      }
    },
    "Agents": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agentes"
          }
        }
      }
    },
    "Allow AgentBar in System Settings › General › Login Items.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o AgentBar em Ajustes do Sistema › Geral › Itens de Início."
          }
        }
      }
    },
